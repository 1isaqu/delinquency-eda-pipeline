# Placeholders only. Copy to .env (gitignored) and edit, or export the variables.
# Only database-reading stages (period, schema, base, card) use these. Offline stages read the
# dataset file written by `base` and need no connection.

# Which adapter to use: sqlserver | sqlite
DEA_BACKEND=sqlserver

# One entry per product line: <product_line>=<target>, comma separated.
# sqlserver: target is a database name on the server below.
# sqlite:    target is a file path.
DEA_SOURCES=auto=collections_auto,consumer=collections_consumer

# Optional path to a JSON settings file (see examples/settings.example.json).
DEA_CONFIG=

# --- SQL Server connection (used when DEA_BACKEND=sqlserver) ---
DEA_DB_DRIVER=ODBC Driver 18 for SQL Server
DEA_DB_HOST=localhost
DEA_DB_PORT=1433
# Leave DEA_DB_USER empty to use integrated authentication (Trusted_Connection).
DEA_DB_USER=report_reader
DEA_DB_PASSWORD=change-me
# Optional schema. Used to filter introspection and to qualify table names (for example dbo).
DEA_DB_SCHEMA=
# yes only for local test servers with self-signed certificates.
DEA_DB_TRUST_SERVER_CERT=no
# Character encoding the driver should use for CHAR/VARCHAR columns (cp1252 for Latin-1 collations).
DEA_DB_CHAR_ENCODING=utf-8
DEA_DB_LOGIN_TIMEOUT=10
DEA_DB_QUERY_TIMEOUT=120
